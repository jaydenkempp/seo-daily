diff --git a/index.html b/index.html
index 9e18aab..1520129 100644
--- a/index.html
+++ b/index.html
@@ -782,23 +782,23 @@ const BANK = [
 
 
 /* ---------- News feed (refreshed by a scheduled task; newest first) ---------- */
-const NEWS_UPDATED = "2026-11-10";
+const NEWS_UPDATED = "2026-11-17";
 const NEWS = [
+["2026-11-16", "Google Search Central", "Search Analytics API adds branded, multimodal and multi-filter options", "The API now matches Search Console's UI: `brandedClassification` grouping, a `webMultimodal` type for Lens and Circle to Search data, and `filterLists` for several countries or devices per request.", "https://developers.google.com/search/blog/2026/11/search-analytics-api-update"],
+["2026-11-12", "Google Search Central", "New doc: identifying Google Search traffic via the `Referer` header", "Google explains which referrer values mark Search visits in analytics or server logs, why the header is sometimes empty, and why counts won't match Search Console.", "https://developers.google.com/search/docs/monitor-debug/identify-google-search-traffic"],
+["2026-11-12", "Search Engine Roundtable", "Search Console Generative AI report under-counted impressions Nov 9–11", "Google's data anomalies page blames a logging error; actual Search performance wasn't affected, though the window overlaps the core update's start.", "https://www.seroundtable.com/google-generative-ai-performance-report-data-bug-42527.html"],
+["2026-11-12", "Google", "Gemini 4 Hydrogen now powers AI Mode and harder AI Overviews globally", "Google calls it its biggest Search model upgrade yet, with better handling of complex queries and a wider query fan-out to surface more links.", "https://blog.google/products-and-platforms/products/search/gemini-4-hydrogen-search-upgrade/"],
+["2026-11-11", "Search Engine Roundtable", "Google: a CDN migration can flood your origin with Googlebot crawling", "Pre-warm the cache, allow verified crawlers, block bad bots selectively, rate-limit, and watch server health and crawl stats during the move.", "https://www.seroundtable.com/google-search-cdn-42511.html"],
+["2026-11-11", "Search Engine Roundtable", "Mueller: many 'Crawled/Discovered – currently not indexed' URLs signal site quality doubts", "Simply shrinking the site won't fix it; very few indexed pages points to either a serious technical issue or Google being unconvinced about the site.", "https://www.seroundtable.com/google-crawled-discovered-currently-not-indexed-42507.html"],
+["2026-11-10", "Google Search Status Dashboard", "November 2026 core update begins rolling out", "The third core update of 2026 is global, may take up to two weeks, and Google advises waiting until it finishes before comparing Search Console data.", "https://www.searchenginejournal.com/google-november-2026-core-update/596614/"],
 ["2026-11-09","Google Search Central","EEA aggregator and supplier units now cover 'things to do' searches","Google's documentation changelog says the Europe-only comparison and direct-provider units now also appear for tours, attractions and activities queries.","https://developers.google.com/search/updates"],
 ["2026-11-05","Search Engine Journal","Gary Illyes on how 301 and 302 redirects treat ranking signals","A 301 makes the target URL canonical and moves signals to it; with a 302, Google keeps showing the old URL because the move is meant to be temporary.","https://www.searchenginejournal.com/google-explains-how-redirects-affect-ranking-signals/595967/"],
 ["2026-11-03","Search Engine Roundtable","Mueller: robots.txt can keep a popup script out of Google's render","Disallowing a popup vendor's domain, or a JS file used only for the popup, stops Googlebot fetching it while rendering. Don't block shared, multipurpose scripts.","https://seroundtable.com/google-robots-block-popups-42445.html"],
 ["2026-11-05","Search Engine Roundtable","Search Console's Performance report gets multi-select device filters","You can now pick several device types at once, following the multi-select country filter added about a month ago.","https://www.seroundtable.com/google-performance-report-multi-select-device-filters-42457.html"],
 ["2026-11-04","Search Engine Roundtable","Google tells sites their site reputation abuse actions no longer apply in the EEA","Search Console emails confirm the August 30 change: these manual actions no longer affect results for European Economic Area users, but still apply elsewhere.","https://seroundtable.com/google-email-site-reputation-policy-eea-42462.html"],
-["2026-10-30","Search Engine Roundtable","Gary Illyes: AI scraping has made fake Googlebot traffic worse","Faking the Googlebot user agent is trivial, so verify by IP with reverse and forward DNS or Google's published IP range files.","https://www.seroundtable.com/google-ai-made-bot-impersonation-worse-42422.html"],
 ["2026-11-06","Search Engine Roundtable","OpenAI says ChatGPT search is about 20% of Google's search volume","The same weekly recap covers Facebook's AI-content strategy and Google's scaled content abuse policy.","https://www.seroundtable.com/video-11-06-2026-42469.html"],
 ["2026-11-05","Search Engine Roundtable","Google can temporarily protect important URLs from being deindexed","Gary Illyes: when a very important URL serves a 4xx (VLC served a 418), Search may keep it indexed briefly.","https://seroundtable.com/google-protected-important-urls-index-42464.html"],
-["2026-10-30","Google Search Central","Google plans to support a shared AI-training opt-out in robots.txt","The cross-provider token `__usage_ai-training` from an IETF draft. Google aims for 2027, and Google-Extended keeps working.","https://www.digitalapplied.com/blog/google-robots-txt-ai-training-control"],
-["2026-10-30","Search Engine Roundtable","AI Overviews on 80%+ of searches; Google updates UGC spam guidance","Third-party data shows AI Overview coverage rising. Google's user-generated spam doc now covers tools that let users publish pages and apps.","https://www.seroundtable.com/video-10-30-2026-42418.html"],
-["2026-10-23","Search Engine Roundtable","JPEG XL isn't supported by Google Images or Discover","Also this week: AI Overview citation cards with AI summaries, and a Google video on robots.txt rules.","https://www.seroundtable.com/video-10-23-2026-42362.html"],
-["2026-07-10","Search Engine Roundtable","Search Console shows performance for YouTube, Instagram, TikTok and X content","Platform properties rolled out. Google says canonicalization fixes can take up to two weeks.","https://www.seroundtable.com/video-07-10-2026-41660.html"],
-["2026-06-03","Google","New Search Console control to opt out of generative AI Search features","Sites can opt out of AI Overviews, AI Mode and Discover AI features. Google says it isn't a ranking signal for regular results.","https://blog.google/products-and-platforms/products/search/new-controls-website-owners/"],
-["2026-06","Google Search Central","Search Generative AI performance reports arrive in Search Console","Dedicated reporting for AI features, rolled out to all sites worldwide by the end of August.","https://developers.google.com/search/blog/2026/06/gen-ai-performance-reports"],
-["2026-05-21","Search Engine Journal","Google rolls out the May 2026 core update","The second broad core update of 2026, about six weeks after the March update finished.","https://www.searchenginejournal.com/google-begins-rolling-out-may-2026-core-update/575589/"]
+["2026-10-30","Google Search Central","Google plans to support a shared AI-training opt-out in robots.txt","The cross-provider token `__usage_ai-training` from an IETF draft. Google aims for 2027, and Google-Extended keeps working.","https://www.digitalapplied.com/blog/google-robots-txt-ai-training-control"]
 ]; /*NEWS_END*/
 
